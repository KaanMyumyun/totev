# Copy to .env and change the values.
# Random key for signing sessions: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
# Password of the first administrator "admin" (used only when the database is created).
ADMIN_PASSWORD=change-me-123
# 1 = load the demo fleet on the first start
LOAD_DEMO_DATA=0
# 1 when the site is served over HTTPS (behind a reverse proxy)
SESSION_COOKIE_SECURE=0
REMINDER_DAYS_AHEAD=30
REMINDER_KM_AHEAD=1000
BACKUP_KEEP=14
