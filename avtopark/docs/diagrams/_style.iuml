!pragma layout smetana
skinparam defaultFontName "Noto Sans"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 8
skinparam backgroundColor white
skinparam ArrowColor #34495e
skinparam ActorBorderColor #1f4e79
skinparam ActorBackgroundColor #dbe7f3
skinparam UsecaseBorderColor #1f4e79
skinparam UsecaseBackgroundColor #eef4fa
skinparam RectangleBorderColor #1f4e79
skinparam ClassBorderColor #1f4e79
skinparam ClassBackgroundColor #f7fafd
skinparam ClassHeaderBackgroundColor #dbe7f3
skinparam EntityBorderColor #1f4e79
skinparam EntityBackgroundColor #f7fafd
skinparam ComponentBorderColor #1f4e79
skinparam ComponentBackgroundColor #eef4fa
skinparam DatabaseBorderColor #1f4e79
skinparam DatabaseBackgroundColor #dbe7f3
skinparam NoteBackgroundColor #fff8e1
skinparam NoteBorderColor #c98a00
skinparam PackageBorderColor #7f8c8d
skinparam SequenceLifeLineBorderColor #7f8c8d
skinparam ParticipantBorderColor #1f4e79
skinparam ParticipantBackgroundColor #eef4fa
skinparam ActivityBorderColor #1f4e79
skinparam ActivityBackgroundColor #eef4fa
skinparam ActivityDiamondBorderColor #1f4e79
skinparam ActivityDiamondBackgroundColor #fff8e1
